# ========================================================
# DecisionGuard AI Backend Environment Variables
# ========================================================
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM Provider Configuration ---
# Set LLM_PROVIDER to: 'gemini', 'openai', 'groq', or 'custom'
# You can set LLM_API_KEY, or provider-specific keys (GEMINI_API_KEY, OPENAI_API_KEY, GROQ_API_KEY)

# Option 1: Google Gemini (Recommended - Fast & Free tier available)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# Option 2: OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# Option 3: Groq
# LLM_PROVIDER=groq
# LLM_API_KEY=your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# Option 4: LocalAI / Ollama / Custom OpenAI-compatible
# LLM_PROVIDER=custom
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=llama3
# LLM_BASE_URL=http://localhost:11434/v1